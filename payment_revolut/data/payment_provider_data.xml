<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_revolut" model="payment.provider">
        <field name="name">Revolut</field>
        <field name="code">revolut</field>
        <field name="state">disabled</field>
        <field name="is_published" eval="False"/>
        <field name="module_id" ref="base.module_payment_revolut"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_revolut_pay'),
                     ])]"
        />
        <field name="image_128" type="base64" file="payment_revolut/static/description/icon.png"/>
    </record>

    <!-- The core record restricts Revolut Pay to the United Kingdom, but Revolut Pay is available
         to customers across the EEA and beyond. The hosted checkout page decides which payment
         methods to surface, so no country restriction is needed on the Odoo side. -->
    <record id="payment.payment_method_revolut_pay" model="payment.method">
        <field name="supported_country_ids" eval="[Command.clear()]"/>
    </record>

</odoo>
